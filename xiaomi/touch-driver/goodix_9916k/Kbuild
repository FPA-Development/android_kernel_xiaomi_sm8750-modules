DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))

LINUX_INC +=	-Iinclude/linux \
		-Iinclude/linux/drm

CDEFINES +=	-Wall \
		-Werror \
		-D__linux__

KBUILD_CPPFLAGS += $(CDEFINES)

ccflags-y += $(LINUX_INC)
ccflags-y += -I$(DIR)
ccflags-y += -I$(DIR)../xiaomi

ifeq ($(call cc-option-yn, -Wmaybe-uninitialized),y)
EXTRA_CFLAGS += -Wmaybe-uninitialized
endif

ifeq ($(call cc-option-yn, -Wheader-guard),y)
EXTRA_CFLAGS += -Wheader-guard
endif

obj-m += goodix_core.o
goodix_core-y := \
	goodix_brl_i2c.o \
	goodix_brl_spi.o \
	goodix_ts_core.o \
	goodix_brl_hw.o \
	goodix_cfg_bin.o \
	goodix_ts_utils.o \
	goodix_brl_fwupdate.o \
	goodix_ts_gesture.o \
	goodix_ts_inspect.o \
	goodix_ts_tools.o \
	goodix_brl_normalize_coeffi_update.o
