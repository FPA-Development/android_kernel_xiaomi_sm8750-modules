ifeq ($(CONFIG_ARCH_SUN), y)
	include $(AUDIO_ROOT)/config/sunauto.conf
	export INCS += -include $(AUDIO_ROOT)/config/sunautoconf.h
endif

# Board specific DAI links, selected with TARGET_PRODUCT=<device>
ifeq ($(TARGET_PRODUCT), dada)
	export INCS += -DCONFIG_TARGET_PRODUCT_DADA
else ifeq ($(TARGET_PRODUCT), annibale)
	export INCS += -DCONFIG_TARGET_PRODUCT_ANNIBALE
endif

